# NearStyle Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI required for cloud deployment)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/nearstyle?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/nearstyle

# JSON Web Token Secret Key (Use a strong random string in production)
JWT_SECRET=nearstyle_super_secret_jwt_key_college_project_2025

# Client Frontend URL for CORS configuration (comma-separated if multiple)
CLIENT_URL=http://localhost:5173
